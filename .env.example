# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/shizuverse
# LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/shizuverse
# REMOTE_DATABASE_URL=postgresql://user:password@render.com:5432/shizuverse

# ── Flask ─────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ENV=local

# ── Admin ─────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password

# ── Twilio WhatsApp (feature-flagged — leave blank to disable) ─
# All three must be set for WhatsApp notifications to fire.
# Until your Twilio Business number is approved, leave these
# empty and all notifications will be logged but not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Shizu contact / payment numbers ───────────────────────────
# Used in notification messages sent to clients.
NEXT_PUBLIC_SHIZU_WHATSAPP=+2250700000000
SHIZU_WAVE_NUMBER=+2250700000000
SHIZU_ORANGE_NUMBER=+2250700000000
SHIZU_MTN_NUMBER=+2250700000000
